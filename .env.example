DISCORD_TOKEN=your-bot-token
# Optional: user id of the official Wordle app. If unset, any bot named "Wordle" is accepted.
WORDLE_BOT_ID=
# Optional: only watch these channel ids (comma separated). Empty = all channels.
WORDLE_CHANNELS=
# Optional: path to the sqlite file
WORDLE_DB=wordle.sqlite3
# Reply with a points summary after recording a day (1/0)
ANNOUNCE=1
# Messages per channel to re-scan on startup so downtime never loses a day (0 = off)
CATCH_UP_LIMIT=300
